# MongoDB Atlas connection string (Database > Connect > Drivers, in Atlas dashboard).
# Format: mongodb+srv scheme, your DB username and password, your cluster host,
# then /expense-tracker as the database name — BEFORE the ?query string, not after it.
MONGODB_URI=

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — which Gemini model lib/llm.ts calls. Code defaults to
# gemini-2.5-flash if this is unset; only set it if you want a different
# model (check aistudio.google.com for the current free-tier list).
# GEMINI_MODEL=gemini-2.5-flash

# Groq API key — https://console.groq.com/keys (free signup, no card needed).
# Text parsing (lib/llm.ts) falls back to Groq once Gemini's daily quota
# (verified ~20 requests/day, 2026-07-31) is exhausted. Without this set,
# a Gemini 429 goes straight to the "AI limit reached" degrade instead.
# Voice parsing has no fallback — Groq's chat models don't understand audio.
GROQ_API_KEY=

# Optional — which Groq model. Defaults to openai/gpt-oss-20b, the smaller of
# the two models Groq's strict structured-output mode currently supports.
# GROQ_MODEL=openai/gpt-oss-20b

# Random secret for signing session JWTs — generate with: openssl rand -base64 32
JWT_SECRET=

# Secret header value for the daily cron endpoint (recurring + hygiene)
CRON_SECRET=

# Used once by scripts/seed-user.ts to create the first (only) user
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me
SEED_USER_NAME=Anees
